generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Attendee {
  id               String        @id @default(cuid())
  fullName         String
  email            String
  phone            String
  ticketType       TicketType
  amount           Int
  paymentStatus    PaymentStatus @default(PENDING)
  reference        String?       @unique
  qrCode           String?
  checkedIn        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  qrToken          String?
  qrTokenUsed      Boolean       @default(false)
  paymentMethod    String?
  confirmedBy      String?
  confirmedAt      DateTime?
  paymentReference String?
  adminNotes       String?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([eventId])
}

model Event {
  id                String    @id
  eventName         String
  slug              String    @unique
  venue             String
  startDateTime     DateTime?
  endDateTime       DateTime?
  legacyEventTime   String?
  imageUrl          String?
  maxCapacity       Int
  earlyBirdPrice    Int?
  saintsRebelsPrice Int?
  fiveFriendsPrice  Int?
  vipPrice          Int?
  regularPrice      Int?
  published         Boolean   @default(false)
  isHistorical      Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  attendees Attendee[]

  @@index([published, endDateTime])
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TicketType {
  VIP
  REGULAR
  EARLY_BIRD
  SAINTS_REBELS
  FIVE_FRIENDS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
