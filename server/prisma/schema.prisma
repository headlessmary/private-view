generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Attendee {
  id              String        @id @default(cuid())
  fullName        String
  email           String
  phone           String
  ticketType      TicketType
  amount          Int
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   String?
  confirmedBy     String?
  confirmedAt     DateTime?
  paymentReference String?
  adminNotes      String?
  reference       String?       @unique
  qrCode          String?
  qrToken         String?
  qrTokenUsed     Boolean       @default(false)
  checkedIn       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventConfig {
  id              String   @id @default("active")
  eventName       String   @default("Headless Society")
  venue           String   @default("Five Friends, Asaba")
  eventDateTime   String   @default("2026-10-29T21:00")
  maxCapacity     Int      @default(60)
  earlyBirdPrice  Int      @default(10000)
  saintsRebelsPrice Int    @default(15000)
  fiveFriendsPrice Int     @default(40000)
  updatedAt       DateTime @updatedAt
}

enum TicketType {
  VIP
  REGULAR
  EARLY_BIRD
  SAINTS_REBELS
  FIVE_FRIENDS
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}
